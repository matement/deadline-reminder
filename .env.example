PORT=3000

# Generate with: npm run generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Any random string. Sent as the X-API-Key header. Leave unset to disable auth.
API_KEY=

# Leave both unset for local dev (falls back to a local SQLite file).
# Required in production on hosts without a persistent disk — see README.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
